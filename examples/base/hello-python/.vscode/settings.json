{
  // Restart extensions whenever direnv loads the dev shell, so they see its
  // tools on PATH.
  "direnv.restart.automatic": true,
  // .envrc runs `uv sync`, which keeps .venv in step with uv.lock.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.typeCheckingMode": "standard",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],

  // Format on save and fix lints (including import order) with Ruff, using
  // the rules in pyproject.toml. Pylance shows type errors like `pyright`.
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  // The dev shell's ruff, linked by .envrc. The extension's bundled ruff needs
  // nix-ld on NixOS.
  "ruff.path": ["${workspaceFolder}/.direnv/bin/ruff"]
}
