# Inside the embedded-dev repo use its local flake; in a standalone project
# (e.g. created with `nix flake init -t`) use the published one.
if [ -f ../../../nix/msp430-gcc.nix ]; then
  use flake ../../..#lab
else
  use flake github:Cyber-Cornell/embedded-dev#lab
fi

# VS Code's Ruff extension runs this ruff (see .vscode/settings.json). Its own
# bundled ruff, like any prebuilt binary from PyPI, needs nix-ld on NixOS.
mkdir -p .direnv/bin && ln -sfn "$(command -v ruff)" .direnv/bin/ruff

# Create or update .venv from uv.lock: pwntools, capstone, unicorn, marimo, ...
# (angr too, if pyproject.toml's default-groups lists it.)
uv sync --quiet || echo "uv sync failed; run it yourself to see why" >&2
