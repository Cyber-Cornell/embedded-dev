# Lint checks for clang-tidy. clangd shows them in the editor, and
# scripts/check-examples.sh runs them in the embedded-dev repo.
Checks: >
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  misc-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  portability-*,
  readability-*,
  -readability-identifier-length
WarningsAsErrors: ""
