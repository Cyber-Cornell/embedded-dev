# Lint checks for clang-tidy. clangd shows them in the editor, and
# scripts/check-examples.sh runs them in the embedded-dev repo.
#
# Turned off because they fight bare-metal code or fire inside SDK headers:
# integer-to-pointer casts, fixed-address (register) dereferences, #define
# register maps, magic numbers, C arrays, linker symbols (reserved names such
# as _sdata, and pointer arithmetic between them), Annex K "_s" functions,
# main() without a hosted environment, and include cycles in vendor headers.
Checks: >
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  clang-analyzer-*,
  -clang-analyzer-core.FixedAddressDereference,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-security.PointerSub,
  misc-*,
  -misc-header-include-cycle,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -misc-use-internal-linkage,
  modernize-*,
  -modernize-avoid-c-arrays,
  -modernize-macro-to-enum,
  -modernize-use-trailing-return-type,
  performance-*,
  -performance-enum-size,
  -performance-no-int-to-ptr,
  portability-*,
  readability-*,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-magic-numbers,
  -readability-uppercase-literal-suffix,
  -readability-use-concise-preprocessor-directives
CheckOptions:
  # SDK logging macros (ESP_LOGI, ...) expand to deeply nested code.
  readability-function-cognitive-complexity.IgnoreMacros: true
WarningsAsErrors: ""
