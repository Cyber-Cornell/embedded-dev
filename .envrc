# Tools for working on this repo (nix develop .#default). Each example has its
# own .envrc with its target's shell.
use flake .

# VS Code's Ruff and ShellCheck extensions run these (see .vscode/settings.json)
# rather than their own bundled binaries, which need nix-ld on NixOS.
mkdir -p .direnv/bin
for tool in ruff shellcheck; do ln -sfn "$(command -v "$tool")" ".direnv/bin/$tool"; done
